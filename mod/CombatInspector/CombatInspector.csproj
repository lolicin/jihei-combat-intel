<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CombatInspector - live combat state reader for 机骸：第九行星 (Unity 2023.2.20f1c1, Mono, DOTS).

    Build against BepInEx 5 (default):
        dotnet build -c Release
    Build against BepInEx 6 Unity.Mono (fallback loader):
        dotnet build -c Release -p:Loader=bepinex6

    Every reference is Private=false: all of these assemblies already exist in the game's
    Managed folder at runtime, so nothing but CombatInspector.dll may be deployed.

    libs/   game assemblies, copied from <game>_Data/Managed by build.ps1
    libs5/  BepInEx 5 loader assemblies
    libs6/  BepInEx 6 (Unity.Mono) loader assemblies
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CombatInspector</AssemblyName>
    <RootNamespace>CombatInspector</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591;NU1701</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Loader Condition="'$(Loader)' == ''">bepinex5</Loader>
    <LibsDir>$(MSBuildThisFileDirectory)..\libs\</LibsDir>
    <LoaderLibsDir Condition="'$(Loader)' != 'bepinex6'">$(MSBuildThisFileDirectory)..\libs5\</LoaderLibsDir>
    <LoaderLibsDir Condition="'$(Loader)' == 'bepinex6'">$(MSBuildThisFileDirectory)..\libs6\</LoaderLibsDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'bepinex6'">
    <DefineConstants>$(DefineConstants);BEPINEX6</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)dashboard.html">
      <LogicalName>CombatInspector.dashboard.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(LibsDir)*.dll">
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="$(LoaderLibsDir)*.dll">
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
